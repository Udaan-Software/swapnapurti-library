generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberType {
  STUDY
  BOOK
  BOTH
}
enum RecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}
enum PlanType {
  STUDY_MONTHLY
  STUDY_QUARTERLY
  STUDY_HALF_YEARLY
  STUDY_YEARLY
  BOOK
  COMBINED
  CUSTOM
}
enum DurationUnit {
  DAY
  MONTH
  YEAR
}
enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}
enum SeatStatus {
  AVAILABLE
  ALLOCATED
  RESERVED
  MAINTENANCE
  DISABLED
}
enum AllocationStatus {
  UPCOMING
  ACTIVE
  RELEASED
  EXPIRED
  CANCELLED
}
enum AttendanceStatus {
  OPEN
  COMPLETED
  CORRECTED
}
enum BookCopyStatus {
  AVAILABLE
  ISSUED
  RESERVED
  LOST
  DAMAGED
  MAINTENANCE
  ARCHIVED
}
enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}
enum ReservationStatus {
  WAITING
  READY
  FULFILLED
  EXPIRED
  CANCELLED
}
enum FineStatus {
  UNPAID
  PARTIAL
  PAID
  WAIVED
}
enum ChargeType {
  SUBSCRIPTION
  OVERDUE_FINE
  LOST_BOOK
  DAMAGED_BOOK
  SECURITY_DEPOSIT
  OTHER
}
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  VOID
}
enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  ONLINE_GATEWAY
}
enum NotificationType {
  MEMBERSHIP_EXPIRING
  MEMBERSHIP_EXPIRED
  PAYMENT_PENDING
  BOOK_DUE
  BOOK_OVERDUE
  RESERVATION_READY
  SEAT_EXPIRING
  SEAT_EXPIRED
  ANNOUNCEMENT
}
enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

model Admin {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  csrfToken String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  adminId   String   @db.Uuid
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([adminId, expiresAt])
}

model Member {
  id               String        @id @default(uuid()) @db.Uuid
  publicId         String        @unique
  fullName         String
  mobile           String        @unique
  email            String?
  dateOfBirth      DateTime?     @db.Date
  gender           String?
  address          String?
  photoUrl         String?
  emergencyContact String?
  registrationDate DateTime      @default(now()) @db.Date
  type             MemberType
  status           RecordStatus  @default(ACTIVE)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  subscriptions    Subscription[]
  allocations      SeatAllocation[]
  attendances      Attendance[]
  loans            BookLoan[]
  reservations     BookReservation[]
  fines            Fine[]
  invoices         Invoice[]
  payments         Payment[]
  notifications    Notification[]
  @@index([fullName])
  @@index([type, status])
  @@index([registrationDate])
}

model MembershipPlan {
  id                  String       @id @default(uuid()) @db.Uuid
  name                String       @unique
  type                PlanType
  price               Decimal      @db.Decimal(12, 2)
  duration            Int
  durationUnit        DurationUnit
  studyAccess         Boolean      @default(false)
  bookAccess          Boolean      @default(false)
  maxBooks            Int          @default(0)
  loanDays            Int          @default(0)
  renewalLimit        Int          @default(0)
  description         String?
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  subscriptions       Subscription[]
  allowedShifts       PlanShift[]
}

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  memberId          String             @db.Uuid
  planId            String             @db.Uuid
  startDate         DateTime           @db.Date
  endDate           DateTime           @db.Date
  status            SubscriptionStatus @default(ACTIVE)
  originalFee       Decimal            @db.Decimal(12, 2)
  discount          Decimal            @default(0) @db.Decimal(12, 2)
  finalFee          Decimal            @db.Decimal(12, 2)
  paymentStatus     PaymentStatus      @default(UNPAID)
  planSnapshot      Json
  renewalReference String?             @db.Uuid
  member            Member             @relation(fields: [memberId], references: [id])
  plan              MembershipPlan     @relation(fields: [planId], references: [id])
  renewedFrom       Subscription?      @relation("SubscriptionRenewal", fields: [renewalReference], references: [id])
  renewals          Subscription[]     @relation("SubscriptionRenewal")
  invoice           Invoice?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  @@index([memberId, status, endDate])
  @@index([endDate])
}

model StudyRoom {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  floor       String?
  description String?
  active      Boolean  @default(true)
  seats       Seat[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Seat {
  id          String     @id @default(uuid()) @db.Uuid
  roomId      String     @db.Uuid
  number      String
  type        String     @default("STANDARD")
  status      SeatStatus @default(AVAILABLE)
  active      Boolean    @default(true)
  notes       String?
  room        StudyRoom  @relation(fields: [roomId], references: [id])
  allocations SeatAllocation[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@unique([roomId, number])
  @@index([roomId, status])
}

model Shift {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @unique
  startMinutes Int
  endMinutes   Int
  crossesMidnight Boolean  @default(false)
  fullDay      Boolean     @default(false)
  active       Boolean     @default(true)
  plans        PlanShift[]
  allocations  SeatAllocation[]
  attendances  Attendance[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model PlanShift {
  planId  String @db.Uuid
  shiftId String @db.Uuid
  plan    MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  shift   Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  @@id([planId, shiftId])
}

model SeatAllocation {
  id        String           @id @default(uuid()) @db.Uuid
  memberId  String           @db.Uuid
  seatId    String           @db.Uuid
  shiftId   String           @db.Uuid
  startDate DateTime         @db.Date
  endDate   DateTime         @db.Date
  status    AllocationStatus @default(ACTIVE)
  member    Member           @relation(fields: [memberId], references: [id])
  seat      Seat             @relation(fields: [seatId], references: [id])
  shift     Shift            @relation(fields: [shiftId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  @@index([seatId, shiftId, startDate, endDate])
  @@index([memberId, status])
}

model Attendance {
  id                String           @id @default(uuid()) @db.Uuid
  memberId          String           @db.Uuid
  shiftId           String?          @db.Uuid
  checkInAt         DateTime
  checkOutAt        DateTime?
  status            AttendanceStatus @default(OPEN)
  correctionReason  String?
  originalCheckInAt DateTime?
  originalCheckOutAt DateTime?
  member            Member           @relation(fields: [memberId], references: [id])
  shift             Shift?           @relation(fields: [shiftId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  @@index([memberId, status])
  @@index([checkInAt])
}

model BookCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  books     Book[]
  createdAt DateTime @default(now())
}

model Book {
  id              String       @id @default(uuid()) @db.Uuid
  title           String
  authors         String
  isbn            String?      @unique
  publisher       String?
  edition         String?
  publicationYear Int?
  categoryId      String?      @db.Uuid
  language        String       @default("English")
  description     String?
  coverUrl        String?
  shelfLocation   String?
  archived        Boolean      @default(false)
  category        BookCategory? @relation(fields: [categoryId], references: [id])
  copies          BookCopy[]
  reservations    BookReservation[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  @@index([title])
  @@index([authors])
  @@index([categoryId])
}

model BookCopy {
  id              String         @id @default(uuid()) @db.Uuid
  bookId          String         @db.Uuid
  accessionNumber String         @unique
  barcode         String         @unique
  acquisitionDate DateTime?      @db.Date
  purchasePrice   Decimal?       @db.Decimal(12, 2)
  condition       String         @default("GOOD")
  status          BookCopyStatus @default(AVAILABLE)
  book            Book           @relation(fields: [bookId], references: [id])
  loans           BookLoan[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@index([bookId, status])
}

model BookLoan {
  id                String     @id @default(uuid()) @db.Uuid
  memberId          String     @db.Uuid
  copyId            String     @db.Uuid
  issueDate         DateTime   @db.Date
  dueDate           DateTime   @db.Date
  actualReturnDate  DateTime?  @db.Date
  renewalCount      Int        @default(0)
  status            LoanStatus @default(ACTIVE)
  conditionAtIssue  String
  conditionAtReturn String?
  member            Member     @relation(fields: [memberId], references: [id])
  copy              BookCopy   @relation(fields: [copyId], references: [id])
  renewals          LoanRenewalHistory[]
  fines             Fine[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  @@index([memberId, status])
  @@index([copyId, status])
  @@index([dueDate, status])
}

model LoanRenewalHistory {
  id         String   @id @default(uuid()) @db.Uuid
  loanId     String   @db.Uuid
  oldDueDate DateTime @db.Date
  newDueDate DateTime @db.Date
  renewedAt  DateTime @default(now())
  loan       BookLoan @relation(fields: [loanId], references: [id])
}

model BookReservation {
  id          String            @id @default(uuid()) @db.Uuid
  memberId    String            @db.Uuid
  bookId      String            @db.Uuid
  queueNumber Int
  status      ReservationStatus @default(WAITING)
  readyAt     DateTime?
  expiresAt   DateTime?
  member      Member            @relation(fields: [memberId], references: [id])
  book        Book              @relation(fields: [bookId], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@unique([bookId, queueNumber])
  @@index([bookId, status, queueNumber])
}

model Fine {
  id             String     @id @default(uuid()) @db.Uuid
  memberId       String     @db.Uuid
  loanId         String?    @db.Uuid
  type           ChargeType
  amount         Decimal    @db.Decimal(12, 2)
  paidAmount     Decimal    @default(0) @db.Decimal(12, 2)
  status         FineStatus @default(UNPAID)
  reason         String
  adjustmentReason String?
  member         Member     @relation(fields: [memberId], references: [id])
  loan           BookLoan?  @relation(fields: [loanId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  @@index([memberId, status])
}

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  invoiceNo   String        @unique
  memberId    String        @db.Uuid
  subscriptionId String?    @unique @db.Uuid
  status      InvoiceStatus @default(ISSUED)
  total       Decimal       @db.Decimal(12, 2)
  paid        Decimal       @default(0) @db.Decimal(12, 2)
  dueDate     DateTime?     @db.Date
  member      Member        @relation(fields: [memberId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  allocations PaymentAllocation[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([memberId, status])
}

model InvoiceItem {
  id          String     @id @default(uuid()) @db.Uuid
  invoiceId   String     @db.Uuid
  type        ChargeType
  description String
  quantity    Int        @default(1)
  unitAmount  Decimal    @db.Decimal(12, 2)
  total       Decimal    @db.Decimal(12, 2)
  invoice     Invoice    @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  receiptNo     String        @unique
  memberId      String        @db.Uuid
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?
  idempotencyKey String?      @unique
  paidAt        DateTime      @default(now())
  member        Member        @relation(fields: [memberId], references: [id])
  allocations   PaymentAllocation[]
  refunds       Refund[]
  createdAt     DateTime      @default(now())
  @@index([memberId, paidAt])
}

model PaymentAllocation {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  invoiceId String  @db.Uuid
  amount    Decimal @db.Decimal(12, 2)
  payment   Payment @relation(fields: [paymentId], references: [id])
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  @@unique([paymentId, invoiceId])
}

model Refund {
  id        String   @id @default(uuid()) @db.Uuid
  paymentId String   @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  reason    String
  refundedAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id])
}

model Expense {
  id          String        @id @default(uuid()) @db.Uuid
  category    String
  description String
  amount      Decimal       @db.Decimal(12, 2)
  expenseDate DateTime      @db.Date
  method      PaymentMethod
  reference   String?
  attachmentUrl String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@index([expenseDate, category])
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  memberId  String?            @db.Uuid
  type      NotificationType
  title     String
  message   String
  status    NotificationStatus @default(UNREAD)
  scheduledAt DateTime?
  sentAt    DateTime?
  dedupeKey String?            @unique
  member    Member?            @relation(fields: [memberId], references: [id])
  createdAt DateTime           @default(now())
  @@index([status, createdAt])
}

model NotificationTemplate {
  id        String           @id @default(uuid()) @db.Uuid
  type      NotificationType @unique
  subject   String
  body      String
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  changes    Json?
  reason     String?
  ipAddress  String?
  admin      Admin?   @relation(fields: [adminId], references: [id])
  createdAt  DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}
